# Copy to .env and fill in — or run  uv run python cli.py setup  which asks and writes this file.
# .env is gitignored — never commit real values (R3).

# AI that runs the job search. claude-code (default) = Claude Code on your Claude subscription,
# no API key; never set ANTHROPIC_API_KEY (R7). Or an OpenAI-compatible provider:
# groq | openai | openrouter | mistral | ollama | custom (custom needs LLM_BASE_URL, a .../v1 URL).
# The models per task are the settings llm_model_filter / llm_model_writer (setup lists them).
LLM_PROVIDER=claude-code
LLM_API_KEY=
LLM_BASE_URL=

# Himalayas remote-jobs API (optional, free key at https://himalayas.app/api). Empty = the shared
# public allowance. Requests are cached for 6 h either way.
HIMALAYAS_API_KEY=

# Telegram (required; cli.py setup walks you through it) — bot from @BotFather; chat id: cli.py telegram-setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mail (optional): two roles, IMAP over SSL only, app passwords only (never your normal password).
# Each role can use any provider; the IMAP host is taken from, in this order: <ROLE>_IMAP_HOST,
# <ROLE>_MAIL_PROVIDER (yahoo | gmail | gmx | webde | t-online | icloud), the address' domain.

# SEND account — application emails are saved here as DRAFTS. Nothing is ever sent.
# Leave empty for no drafts (you write those emails yourself from the apply kit).
SEND_MAIL_ADDRESS=
SEND_MAIL_APP_PASSWORD=
SEND_MAIL_PROVIDER=
SEND_IMAP_HOST=
SEND_IMAP_PORT=993

# ALERTS account — read-only: the email_alerts source reads LinkedIn/Instaffo job alerts here.
# Never used for drafts or sending. Leave address/password empty to read alerts from the SEND
# account instead; with neither set, the email_alerts source finds nothing.
ALERTS_MAIL_ADDRESS=
ALERTS_MAIL_APP_PASSWORD=
ALERTS_MAIL_PROVIDER=
ALERTS_IMAP_HOST=
ALERTS_IMAP_PORT=993

# Web UI from phones/tablets on the PC's Mobile Hotspot (default: this PC only).
# UI_LAN=1 binds the UI to all interfaces; only devices in UI_LAN_SUBNETS that were paired with a
# one-time code (Settings → Pair a device, on the PC) get in. The secret signs their cookies:
# generate it with  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing the secret signs out every paired device.
UI_LAN=0
UI_LAN_SUBNETS=192.168.137.0/24
UI_SESSION_SECRET=
# Optional: reach the UI from anywhere through a reverse tunnel (e.g. Cloudflare). Host names the
# tunnel uses, comma-separated; ".example.com" = any subdomain (quick tunnels: .trycloudflare.com).
# Visitors must pair like hotspot devices (needs UI_SESSION_SECRET). Production server only:
#   cd ui; npm run build; npm start      then   cloudflared tunnel --url http://127.0.0.1:5173
UI_TUNNEL_HOSTS=

# Optional: override the database location (default: data/jobhunter.db)
# JOBHUNTER_DB=
